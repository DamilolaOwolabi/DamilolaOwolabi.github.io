---
layout: default
---
{% comment %}
  Local override of al_folio_core's about layout.
  Adds a hero (eyebrow, name, tagline, call-to-action buttons, social links)
  driven by the `hero:` block in _pages/about.md. Everything below the hero
  (news, latest posts, selected papers) behaves like the upstream layout.
{% endcomment %}
<div class="post about-page">
  <section class="hero" aria-labelledby="hero-name">
    <canvas class="hero-grid" aria-hidden="true"></canvas>
    <div class="hero-text">
      {% if page.hero.eyebrow %}
        <p class="hero-eyebrow">{{ page.hero.eyebrow }}</p>
      {% endif %}
      <h1 class="hero-name" id="hero-name">
        {% if site.title == 'blank' -%}
          {{- site.first_name }}
          {{ site.last_name -}}
        {%- else -%}
          {{- site.title -}}
        {%- endif %}
      </h1>
      {% if page.hero.tagline %}
        <p class="hero-tagline">{{ page.hero.tagline }}</p>
      {% endif %}
      {% if page.hero.buttons %}
        <div class="hero-actions">
          {% for button in page.hero.buttons %}
            {% if button.url contains '://' or button.url contains 'mailto:' %}
              {% assign button_url = button.url %}
            {% else %}
              {% assign button_url = button.url | relative_url %}
            {% endif %}
            <a
              class="hero-btn {% if forloop.first %}hero-btn-primary{% else %}hero-btn-secondary{% endif %}"
              href="{{ button_url }}"
              {% if button.download %}
                download
              {% endif %}
            >
              {% if button.icon %}<i class="{{ button.icon }}" aria-hidden="true"></i>{% endif %}
              <span>{{ button.label }}</span>
            </a>
          {% endfor %}
        </div>
      {% endif %}
      {% if page.social %}
        <div class="hero-social" aria-label="Social links">{% social_links %}</div>
      {% endif %}
    </div>

    {% if page.profile.image %}
      <div class="hero-photo">
        {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
        {%
          include figure.liquid loading="eager" path=profile_image_path class="hero-photo-img" sizes="(min-width: 768px) 280px, 60vw"
          alt=page.profile.alt cache_bust=true
        %}
      </div>
    {% endif %}
  </section>

  {% if page.glance %}
    <dl class="glance" aria-label="At a glance" data-reveal>
      {% for fact in page.glance %}
        <div class="glance-item">
          <dt>{{ fact.label }}</dt>
          <dd>{{ fact.value }}</dd>
        </div>
      {% endfor %}
    </dl>
  {% endif %}

  <article class="about-body" data-reveal>
    <h2 class="section-label">About</h2>
    {{ content }}
  </article>

  {% if page.timeline %}
    <section class="home-section" aria-labelledby="timeline-heading" data-reveal>
      <h2 class="section-label" id="timeline-heading">Path so far</h2>
      <ol class="timeline">
        {% for item in page.timeline %}
          <li class="timeline-item{% if item.current %} is-current{% endif %}">
            <span class="timeline-when">{{ item.when }}</span>
            <div class="timeline-body">
              <h3>
                {{ item.title }}
                <span class="timeline-org">· {{ item.org }}</span>
              </h3>
              {% if item.note %}
                <p>{{ item.note }}</p>
              {% endif %}
            </div>
          </li>
        {% endfor %}
      </ol>
    </section>
  {% endif %}

  {% assign ercot = site.data.ercot %}
  {% if ercot and ercot.peak_gen_mw %}
    <section class="home-section" aria-labelledby="grid-heading" data-reveal>
      <h2 class="section-label" id="grid-heading">Texas grid snapshot</h2>
      <div class="snapshot-card">
        <div class="snapshot-head">
          <p class="snapshot-title"><span class="live-dot" aria-hidden="true"></span>ERCOT · {{ ercot.day_label }}</p>
          <p class="snapshot-sub">Refreshed daily from ERCOT's public fuel mix data</p>
        </div>
        <div class="snapshot-stats">
          <div class="stat">
            <span class="stat-value">{{ ercot.peak_gen_mw | divided_by: 1000.0 | round: 1 }} GW</span>
            <span class="stat-label">Peak generation · {{ ercot.peak_time }}</span>
          </div>
          <div class="stat">
            <span class="stat-value">{{ ercot.wind_share_pct }}%</span>
            <span class="stat-label">From wind</span>
          </div>
          <div class="stat">
            <span class="stat-value">{{ ercot.solar_share_pct }}%</span>
            <span class="stat-label">From solar</span>
          </div>
          <div class="stat">
            <span class="stat-value">{{ ercot.wind_peak_mw | divided_by: 1000.0 | round: 1 }} GW</span>
            <span class="stat-label">Wind peak · {{ ercot.wind_peak_time }}</span>
          </div>
        </div>
        {% if ercot.sparkline_path != '' %}
          <figure class="snapshot-spark">
            <svg viewBox="0 0 240 48" preserveAspectRatio="none" role="img" aria-label="Hourly generation across the day">
              <path class="spark-area" d="{{ ercot.sparkline_path }} L237,45 L3,45 Z"></path>
              <path class="spark-line" d="{{ ercot.sparkline_path }}"></path>
            </svg>
            <figcaption>Hourly generation, midnight to midnight</figcaption>
          </figure>
        {% endif %}
        <div class="fuel-bar" role="img" aria-label="Fuel mix for the day">
          {% for f in ercot.fuel_shares %}
            <span class="fuel-seg fuel-{{ f.key }}" style="width: {{ f.pct }}%" title="{{ f.label }} {{ f.pct }}%"></span>
          {% endfor %}
        </div>
        <ul class="fuel-legend">
          {% for f in ercot.fuel_shares %}
            <li>
              <span class="fuel-dot fuel-{{ f.key }}" aria-hidden="true"></span>{{ f.label }}
              {{ f.pct }}%
            </li>
          {% endfor %}
        </ul>
        <p class="snapshot-foot">
          Source: <a href="{{ ercot.source_url }}" target="_blank" rel="noopener">{{ ercot.source }}</a>. Pulled each morning by a small Python job I
          wrote that runs on GitHub Actions.
        </p>
      </div>
    </section>
  {% endif %}

  {% if page.skills %}
    <section class="home-section" aria-labelledby="skills-heading" data-reveal>
      <h2 class="section-label" id="skills-heading">Skills</h2>
      <div class="skills-grid">
        {% for group in page.skills %}
          <div class="skill-group">
            <h3>{{ group.group }}</h3>
            <ul class="tool-chips">
              {% for item in group.items %}
                <li>{{ item }}</li>
              {% endfor %}
            </ul>
          </div>
        {% endfor %}
      </div>
    </section>
  {% endif %}

  <!-- News -->
  {% if page.announcements and page.announcements.enabled %}
    <section class="home-section">
      <h2 class="section-label"><a href="{{ '/news/' | relative_url }}">News</a></h2>
      {% include news.liquid limit=true %}
    </section>
  {% endif %}

  <!-- Latest posts -->
  {% if page.latest_posts and page.latest_posts.enabled %}
    <section class="home-section">
      <h2 class="section-label"><a href="{{ '/blog/' | relative_url }}">Latest posts</a></h2>
      {% include latest_posts.liquid %}
    </section>
  {% endif %}

  <!-- Selected papers -->
  {% if page.selected_papers %}
    <section class="home-section">
      <h2 class="section-label"><a href="{{ '/publications/' | relative_url }}">Selected publication</a></h2>
      {% include selected_papers.liquid %}
    </section>
  {% endif %}

  {% if page.contact %}
    <section class="contact-cta" aria-labelledby="contact-heading" data-reveal>
      <div>
        <h2 id="contact-heading">{{ page.contact.heading }}</h2>
        <p>{{ page.contact.text }}</p>
      </div>
      <div class="hero-actions">
        {% if page.contact.email %}
          <a class="hero-btn hero-btn-primary" href="mailto:{{ page.contact.email }}">
            <i class="fa-solid fa-envelope" aria-hidden="true"></i><span>Email me</span>
          </a>
        {% endif %}
        {% if page.contact.linkedin %}
          <a class="hero-btn hero-btn-secondary" href="{{ page.contact.linkedin }}" target="_blank" rel="noopener">
            <i class="fa-brands fa-linkedin" aria-hidden="true"></i><span>LinkedIn</span>
          </a>
        {% endif %}
      </div>
    </section>
  {% endif %}

  {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
    {% if site.plugins contains 'al_newsletter' %}
      {% include plugins/al_newsletter_form_center_margin.liquid %}
    {% else %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  {% endif %}
</div>

<script defer src="{{ '/assets/js/site.js' | relative_url | bust_file_cache }}"></script>
